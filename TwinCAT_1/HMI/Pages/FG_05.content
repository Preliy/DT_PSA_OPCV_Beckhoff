</div>

<div id="FG05_B_Part" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-target-user-control="UserControls/BinarySensor.usercontrol" data-tchmi-left="1373" data-tchmi-left-unit="px" data-tchmi-top="458" data-tchmi-top-unit="px" data-tchmi-width="260" data-tchmi-width-unit="px" data-tchmi-height="120" data-tchmi-height-unit="px" data-tchmi-sensor="%s%ADS.PLC1.MAIN.Machine.FG_05.B_Part::DigitalSensor_HMI%/s%" data-tchmi-component="%s%ADS.PLC1.MAIN.Machine.FG_05.B_Part::ComponentBase_HMI%/s%" data-tchmi-width-mode="Content" data-tchmi-height-mode="Content">
</div>

<div id="FG05_Y_CapsSource" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-target-user-control="UserControls/Bunker.usercontrol" data-tchmi-left="1373" data-tchmi-left-unit="px" data-tchmi-top="588" data-tchmi-top-unit="px" data-tchmi-width="260" data-tchmi-width-unit="px" data-tchmi-height="120" data-tchmi-height-unit="px" data-tchmi-bunker="%s%ADS.PLC1.MAIN.Machine.FG_05.Y_CapsSource.HMI%/s%" data-tchmi-width-mode="Content" data-tchmi-height-mode="Content">
</div>

<div id="TcHmiStateMachineV2_5" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiPackML.TcHmiStateMachineV2" data-tchmi-height="321" data-tchmi-height-unit="px" data-tchmi-left="20" data-tchmi-left-unit="px" data-tchmi-top="73" data-tchmi-top-unit="px" data-tchmi-width="800" data-tchmi-width-unit="px" data-tchmi-state-current="%s%ADS.PLC1.MAIN.Machine.FG_05.HMI::Status::State%/s%" data-tchmi-unit-mode-current="%s%ADS.PLC1.MAIN.Machine.FG_05.HMI::Status::Mode%/s%" data-tchmi-command="%s%ADS.PLC1.MAIN.Machine.FG_05.HMI::Command::State%/s%">
