        "asyncWait": true
      }
    ]
  }
]</script>
</div>

<div id="Bnk_ConveyorText" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="34" data-tchmi-left-unit="px" data-tchmi-top="58" data-tchmi-top-unit="px" data-tchmi-width="150" data-tchmi-width-unit="px" data-tchmi-height="18" data-tchmi-height-unit="px" data-tchmi-text="Feed conveyor">
</div>

<div id="Bnk_TableBtn" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-left="10" data-tchmi-left-unit="px" data-tchmi-top="84" data-tchmi-top-unit="px" data-tchmi-width="115" data-tchmi-width-unit="px" data-tchmi-height="28" data-tchmi-height-unit="px" data-tchmi-text="Table" data-tchmi-is-enabled="%pp%Bunker::Status::HMIControlAvailable%/pp%" data-tchmi-state-symbol="%pp%Bunker::DeviceCommand::RunTable%/pp%">
</div>

<div id="Bnk_ConveyorBtn" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-left="135" data-tchmi-left-unit="px" data-tchmi-top="84" data-tchmi-top-unit="px" data-tchmi-width="115" data-tchmi-width-unit="px" data-tchmi-height="28" data-tchmi-height-unit="px" data-tchmi-text="Conveyor" data-tchmi-is-enabled="%pp%Bunker::Status::HMIControlAvailable%/pp%" data-tchmi-state-symbol="%pp%Bunker::DeviceCommand::RunConveyor%/pp%">
</div>

</div>
