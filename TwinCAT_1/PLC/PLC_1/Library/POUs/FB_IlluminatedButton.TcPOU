<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="FB_IlluminatedButton" Id="{c893d1b5-24ad-4c92-b9a5-7aa80e998c89}" SpecialFunc="None">
    <Declaration><![CDATA[// ============================================================================
// A button that reports and lights: one input bit, one output bit, one device.
// Maps to the twin's OC_Core FB_Button - bValue (0 released, 1 pressed) and
// bEnable (0 lamp off, 1 lamp on), verified against the OC_Core 1.3.1 binary.
//
// Active IS A LIVE GETTER over the located input, not a cached value. That is why
// this exists instead of FB_DigitalSensor, which computes _Active inside its own
// CyclicLogic and so put a ONE-SCAN LAG on the emergency stops in
// Machine.EnforceSafety. No debounce, no simulation, no timers.
//
// LAYERING: this component does not know what a PackML state is, so it does not
// decide whether its lamp is solid or flashing. It exposes Lamp; the owning module
// writes it - see FG_System.DriveEStopLamps.
//
// !! NOT A SAFETY-RATED COMPONENT. A real emergency stop belongs on TwinSAFE.
FUNCTION_BLOCK FB_IlluminatedButton EXTENDS FB_ComponentBase
VAR
	HardwareInput AT %I* : BOOL;
	LampOutput AT %Q* : BOOL;

	_Lamp : BOOL;
	_Inverted : BOOL;

	// Illuminated button - pressed state, lamp and contact polarity
	{ attribute 'TcHmiSymbol.AddSymbol' }
	HMI : ST_IlluminatedButton_HMI;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Active" Id="{250e637b-7a03-48bc-b281-e82b58e3b63c}">
      <Declaration><![CDATA[// TRUE while the button is pressed. Read straight off the located input, so it is
// this scan's value no matter when the caller reads it - see the header.
PROPERTY Active : BOOL]]></Declaration>
      <Get Name="Get" Id="{785d5b60-6655-48de-ace2-f1645c30c8de}">
        <Declaration><![CDATA[VAR END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Active := HardwareInput XOR _Inverted;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CyclicLogic" Id="{8a2a2461-ced8-4b69-bcf7-fa1a7171edec}">
      <Declaration><![CDATA[METHOD PUBLIC CyclicLogic
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _InitComplete THEN
	_InitComplete := Initialize();
	RETURN;
END_IF

// The whole of it. Active needs no work here - it is a getter over the input.
LampOutput := _Lamp;

_Busy	:= FALSE;
_Error	:= FALSE;

SUPER^.CyclicLogic();

// Device config and status only. The inherited Config / Command / Status half of
// HMI mirrors ComponentBase_HMI and is bridged in HMICommunication.
//
// Publishing is not filling: without these four lines the struct would be a live
// ADS symbol reading zeros forever, which on a panel looks exactly like a button
// nobody is pressing.
HMI.DeviceConfig.Inverted	:= _Inverted;
HMI.Device.Active			:= HardwareInput XOR _Inverted;
HMI.Device.Lamp				:= LampOutput;]]></ST>
      </Implementation>
    </Method>
    <Method Name="HMICommunication" Id="{a1a61a77-308e-405a-879d-66688b49c884}">
      <Declaration><![CDATA[METHOD PROTECTED HMICommunication
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// HMI is a published mirror of the base's own ComponentBase_HMI - carry operator
// intent in before the base looks, and its answers back out afterwards. Same
// shape as FB_AbstractBinaryDrive.
ComponentBase_HMI.Command := HMI.Command;

SUPER^.HMICommunication();

HMI.Config	:= ComponentBase_HMI.Config;
HMI.Status	:= ComponentBase_HMI.Status;
HMI.Command	:= ComponentBase_HMI.Command;

// Polarity is commissioning configuration, so the panel may set it - but only
// while the PLC says HMI control is available for this component.
IF ComponentBase_HMI.Status.HMIControlAvailable THEN
	_Inverted := HMI.DeviceConfig.Inverted;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialize" Id="{7a17d5cb-519a-4630-ab81-b00e32580b8b}">
      <Declaration><![CDATA[METHOD PROTECTED Initialize : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Seed the HMI mirror from the configured polarity BEFORE anything can read it
// back. HMICommunication assigns _Inverted := HMI.DeviceConfig.Inverted whenever
// HMI control is available, and CyclicLogic only publishes the other direction
// AFTER SUPER^.CyclicLogic() has already called it - so on the first executing
// scan the mirror is still the struct's zero default. Without this line, a
// polarity set by the owning module would be silently reverted to FALSE the
// moment the machine was in Manual, which on an emergency stop is the failure
// that matters. Idempotent: Initialize runs every scan until it returns TRUE.
HMI.DeviceConfig.Inverted := _Inverted;

Initialize := SUPER^.Initialize();]]></ST>
      </Implementation>
    </Method>
    <Property Name="Inverted" Id="{e526cd90-f558-4a49-afe7-2b92cd024d1a}">
      <Declaration><![CDATA[// Input polarity of the contact. TRUE means the input is NORMALLY CLOSED: it
// reads TRUE while healthy and FALSE while pressed, so Active is the inverse.
//
// THE TWO EMERGENCY STOPS SET THIS TRUE, in FG_System.Initialize. A physical
// mushroom is wired normally-closed, and the failure mode of getting it the
// other way round is the worst one there is: a cut cable would read as "no
// emergency stop". SIM_1's Mapping inverts the twin's FB_Button - which reports
// bValue TRUE while PRESSED - so the twin presents that same NC sense and the
// control program does not change between twin and hardware.
// See _workflow/reference/plc-io-exceptions.md.
PROPERTY Inverted : BOOL]]></Declaration>
      <Get Name="Get" Id="{fb20003e-ba35-44b5-8f7e-05edf5bc1ef6}">
        <Declaration><![CDATA[VAR END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Inverted := _Inverted;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{c54d4c96-d75b-4ad2-a1d5-a57461db9a74}">
        <Declaration><![CDATA[VAR END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Inverted := Inverted;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="Lamp" Id="{e7e5118f-3b72-4bd1-ac0a-7515a33bb424}">
      <Declaration><![CDATA[// The lamp request. Written every scan by the owning module, which is the only
// level that knows whether this should be solid, flashing or dark.
PROPERTY Lamp : BOOL]]></Declaration>
      <Get Name="Get" Id="{eb2019f9-25a8-40ff-a87d-c297d7ec6e06}">
        <Declaration><![CDATA[VAR END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Lamp := _Lamp;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{d019be9b-6935-4e57-a045-46691ff9c425}">
        <Declaration><![CDATA[VAR END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Lamp := Lamp;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>