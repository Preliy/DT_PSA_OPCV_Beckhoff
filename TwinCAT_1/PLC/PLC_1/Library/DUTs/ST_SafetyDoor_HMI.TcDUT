<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <DUT Name="ST_SafetyDoor_HMI" Id="{468e51f3-abf4-4164-96ac-c4eac5ea3cd2}">
    <Declaration><![CDATA[// Safety door HMI interface - ONE struct per tile.
// Extends ST_ComponentBase_HMI, so one bound parameter also carries Config,
// Command and Status - and the added members may not reuse those three names.
//
// NO DeviceCommand, deliberately. The lock is commanded by FG_System from the
// machine's PackML mode, and a panel able to override that could unlock a running
// cell. FG_System.HMI.Safety carries the same facts as arrays for a whole-cell
// summary; this struct is for a per-door tile.
TYPE ST_SafetyDoor_HMI EXTENDS ST_ComponentBase_HMI :
STRUCT
	DeviceConfig	: ST_SafetyDoor_Config;
	Device			: ST_SafetyDoor_Status;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>