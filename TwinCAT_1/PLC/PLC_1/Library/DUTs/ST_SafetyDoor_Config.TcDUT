<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <DUT Name="ST_SafetyDoor_Config" Id="{83941267-6231-4314-a168-df6dadad1ec0}">
    <Declaration><![CDATA[TYPE ST_SafetyDoor_Config :
STRUCT
	// How long the lock has to confirm after being commanded before fault 1 is
	// raised. Writable from the panel: a sticky lock on a demo cell is exactly the
	// kind of thing tuned against the running machine.
	LockTime : TIME;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>