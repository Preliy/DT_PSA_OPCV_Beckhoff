<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="FG_04" Id="{06f8125c-af48-4619-894e-8922d83c941f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FG_04
{region generated code}
VAR_INPUT
	B_NIO : FB_SensorBinary;
	Y_AxisZ : FB_Cylinder;
END_VAR
{endregion}]]></Declaration>
    <Implementation>
      <ST><![CDATA[{region generated code}
	InitRun();
	B_NIO();
	Y_AxisZ();
{endregion}

