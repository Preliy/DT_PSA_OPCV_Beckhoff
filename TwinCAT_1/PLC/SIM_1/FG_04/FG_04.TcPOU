      </Implementation>
    </Method>
    <Action Name="Mapping" Id="{edab1274-6099-41da-a10c-63392ff253a8}">
      <Implementation>
        <ST><![CDATA[// ============================================================================
// FG_04 twin <-> EtherCAT simulation process image.
//
// The press and its verdict. Y_AxisZ is a double solenoid so that an abort
// mid-stroke leaves it where it is instead of letting a spring drive it further
// into the part.
//
// B_NIO is not a sensor reading. The twin's seating sensor is not a PLC symbol at
// all - its Link is disabled and it feeds PartPressDetector inside Unity, which
// publishes the conclusion here as one bit. The PLC reads it only at the bottom of
// the stroke with the hold expired.
// ============================================================================

// --- B_NIO - binary sensor -------------------------------------------------
// DI FG_04_EL1008_1 3.
GVL_EtherCAT_1_SIM.FG_04_EL1008_1.bIn3	:= B_NIO.bValue;

// --- Y_AxisZ - double solenoid, both coils and both limits -----------------
// DI FG_04_EL1008_1 1/2, DO FG_04_EL2008_1 1/2.
GVL_EtherCAT_1_SIM.FG_04_EL1008_1.bIn1	:= Y_AxisZ.bExtended;
GVL_EtherCAT_1_SIM.FG_04_EL1008_1.bIn2	:= Y_AxisZ.bRetracted;
Y_AxisZ.bExtend	:= GVL_EtherCAT_1_SIM.FG_04_EL2008_1.bOut1;
Y_AxisZ.bRetract	:= GVL_EtherCAT_1_SIM.FG_04_EL2008_1.bOut2;]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>