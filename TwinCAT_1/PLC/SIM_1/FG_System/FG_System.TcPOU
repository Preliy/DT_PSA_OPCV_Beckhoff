<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="FG_System" Id="{05ecf2eb-0e4a-4530-aa0c-07604436f137}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FG_System

{region generated code}
VAR_INPUT
	B_SafetyDoor11 : FB_Lock;
	B_SafetyDoor12 : FB_Lock;
	B_SafetyDoor13 : FB_Lock;
	B_SafetyDoor21 : FB_Lock;
	B_SafetyDoor22 : FB_Lock;
	B_SafetyDoor23 : FB_Lock;
	H_ControlPanel : FB_Panel;
	H_SignalTower : FB_Panel;
	SS_EStop1 : FB_Button;
	SS_EStop2 : FB_Button;
END_VAR
{endregion}]]></Declaration>
    <Implementation>
      <ST><![CDATA[{region generated code}
	InitRun();
	B_SafetyDoor11();
	B_SafetyDoor12();
	B_SafetyDoor13();
	B_SafetyDoor21();
	B_SafetyDoor22();
	B_SafetyDoor23();
	H_ControlPanel();
	H_SignalTower();
	SS_EStop1();
	SS_EStop2();
{endregion}

Mapping();
]]></ST>
    </Implementation>
    <Method Name="InitRun" Id="{f92498df-2f7d-407f-a795-8681e0c73f2b}">
      <Declaration><![CDATA[METHOD InitRun
{region generated code}
VAR_INST
	bInitRun : BOOL := TRUE;
END_VAR
{endregion}]]></Declaration>
      <Implementation>
        <ST><![CDATA[{region generated code}
	IF NOT bInitRun THEN RETURN; END_IF
	bInitRun := FALSE;
{endregion}
]]></ST>
      </Implementation>
    </Method>
    <Action Name="Mapping" Id="{2f7629fd-0e87-4ebb-9bb1-5dc5c18b76d4}">
      <Implementation>
        <ST><![CDATA[// ============================================================================
// FG_System twin <-> EtherCAT simulation process image.
//
// Mirrors Mapping_PLC.xml channel for channel. Panel channel order follows the
// twin's own PanelSampler bit order, verified 2026-08-20 against the live scene,
// so DI channel n and DO channel n are the same button and nothing here needs a
// lookup table:
//   H_ControlPanel  bit0 START  1 RESET  2 STOP   3 CLEAR
//                   bit4 ABORT  5 PRODUCTION  6 MAINTANANCE  7 MANUAL
//   H_SignalTower   bit0 RED    1 YELLOW  2 BLUE  3 GREEN
//
// Direction is baked into which side of the assignment the GVL sits on:
//   twin status  -> bIn*   the PLC reads it
//   bOut*        -> twin control   the PLC drives it
// ============================================================================

// --- H_ControlPanel buttons -> Panel DI 1..8 --------------------------------
// FB_Panel aggregates all eight buttons into one DWORD; the PLC sees eight
// separate channels, which is what lets FB_ControlSource's own located
// StartPressed / StopPressed / ResetPressed inputs link directly.
GVL_EtherCAT_1_SIM.FG_System_Panel_EL1809_1.bIn1	:= H_ControlPanel.nStatusData.0;	// START
GVL_EtherCAT_1_SIM.FG_System_Panel_EL1809_1.bIn2	:= H_ControlPanel.nStatusData.1;	// RESET
GVL_EtherCAT_1_SIM.FG_System_Panel_EL1809_1.bIn3	:= H_ControlPanel.nStatusData.2;	// STOP
GVL_EtherCAT_1_SIM.FG_System_Panel_EL1809_1.bIn4	:= H_ControlPanel.nStatusData.3;	// CLEAR
GVL_EtherCAT_1_SIM.FG_System_Panel_EL1809_1.bIn5	:= H_ControlPanel.nStatusData.4;	// ABORT
GVL_EtherCAT_1_SIM.FG_System_Panel_EL1809_1.bIn6	:= H_ControlPanel.nStatusData.5;	// PRODUCTION
GVL_EtherCAT_1_SIM.FG_System_Panel_EL1809_1.bIn7	:= H_ControlPanel.nStatusData.6;	// MAINTANANCE
GVL_EtherCAT_1_SIM.FG_System_Panel_EL1809_1.bIn8	:= H_ControlPanel.nStatusData.7;	// MANUAL

// --- Emergency stops -> Panel DI 9/10 ---------------------------------------
// FB_Button reports bValue TRUE while PRESSED, and these are Toggle type so a
// click latches. NOT is what makes the twin read like a real NC mushroom -
// TRUE while healthy, FALSE while latched - so PLC_1 needs no twin-only variant:
// FG_System.Initialize sets SS_EStop*.Inverted := TRUE for both cases.
// Do not drop the NOT without clearing that too, in the same edit.
// See _workflow/reference/plc-io-exceptions.md.
GVL_EtherCAT_1_SIM.FG_System_Panel_EL1809_1.bIn9	:= NOT SS_EStop1.bValue;
GVL_EtherCAT_1_SIM.FG_System_Panel_EL1809_1.bIn10	:= NOT SS_EStop2.bValue;

// --- Safety doors -> Door DI 1..12 ------------------------------------------
// Two channels per door, closed then locked, in twin order 11/12/13 then
// 21/22/23. Both are needed: closed alone does not make a guard secure.
GVL_EtherCAT_1_SIM.FG_System_Door_EL1809_1.bIn1		:= B_SafetyDoor11.bClosed;
GVL_EtherCAT_1_SIM.FG_System_Door_EL1809_1.bIn2		:= B_SafetyDoor11.bLocked;
GVL_EtherCAT_1_SIM.FG_System_Door_EL1809_1.bIn3		:= B_SafetyDoor12.bClosed;
GVL_EtherCAT_1_SIM.FG_System_Door_EL1809_1.bIn4		:= B_SafetyDoor12.bLocked;
GVL_EtherCAT_1_SIM.FG_System_Door_EL1809_1.bIn5		:= B_SafetyDoor13.bClosed;
GVL_EtherCAT_1_SIM.FG_System_Door_EL1809_1.bIn6		:= B_SafetyDoor13.bLocked;
GVL_EtherCAT_1_SIM.FG_System_Door_EL1809_1.bIn7		:= B_SafetyDoor21.bClosed;
GVL_EtherCAT_1_SIM.FG_System_Door_EL1809_1.bIn8		:= B_SafetyDoor21.bLocked;
GVL_EtherCAT_1_SIM.FG_System_Door_EL1809_1.bIn9		:= B_SafetyDoor22.bClosed;
GVL_EtherCAT_1_SIM.FG_System_Door_EL1809_1.bIn10	:= B_SafetyDoor22.bLocked;
GVL_EtherCAT_1_SIM.FG_System_Door_EL1809_1.bIn11	:= B_SafetyDoor23.bClosed;
GVL_EtherCAT_1_SIM.FG_System_Door_EL1809_1.bIn12	:= B_SafetyDoor23.bLocked;

// --- Panel DO 1..8 -> H_ControlPanel button lamps ---------------------------
// Same bit order as the buttons above, so channel n lights the button that
// channel n reads.
H_ControlPanel.nControlData.0	:= GVL_EtherCAT_1_SIM.FG_System_Panel_EL2809_1.bOut1;	// START
H_ControlPanel.nControlData.1	:= GVL_EtherCAT_1_SIM.FG_System_Panel_EL2809_1.bOut2;	// RESET
H_ControlPanel.nControlData.2	:= GVL_EtherCAT_1_SIM.FG_System_Panel_EL2809_1.bOut3;	// STOP
H_ControlPanel.nControlData.3	:= GVL_EtherCAT_1_SIM.FG_System_Panel_EL2809_1.bOut4;	// CLEAR
H_ControlPanel.nControlData.4	:= GVL_EtherCAT_1_SIM.FG_System_Panel_EL2809_1.bOut5;	// ABORT
H_ControlPanel.nControlData.5	:= GVL_EtherCAT_1_SIM.FG_System_Panel_EL2809_1.bOut6;	// PRODUCTION
H_ControlPanel.nControlData.6	:= GVL_EtherCAT_1_SIM.FG_System_Panel_EL2809_1.bOut7;	// MAINTANANCE
H_ControlPanel.nControlData.7	:= GVL_EtherCAT_1_SIM.FG_System_Panel_EL2809_1.bOut8;	// MANUAL

// --- Panel DO 9..12 -> H_SignalTower ----------------------------------------
// NOTE the tower is four lamps and GREEN is bit 3, not bit 2. The twin's
// authored prose said three lamps with GREEN at bit 2 until 2026-08-20.
H_SignalTower.nControlData.0	:= GVL_EtherCAT_1_SIM.FG_System_Panel_EL2809_1.bOut9;	// RED
H_SignalTower.nControlData.1	:= GVL_EtherCAT_1_SIM.FG_System_Panel_EL2809_1.bOut10;	// YELLOW
H_SignalTower.nControlData.2	:= GVL_EtherCAT_1_SIM.FG_System_Panel_EL2809_1.bOut11;	// BLUE
H_SignalTower.nControlData.3	:= GVL_EtherCAT_1_SIM.FG_System_Panel_EL2809_1.bOut12;	// GREEN

// --- Panel DO 13/14 -> the mushrooms' own lamps -----------------------------
// FB_Button.bEnable is the lamp: 0 off, 1 on, confirmed in the OC_Core binary.
// The twin's Emergency Switch prefab has _localFeedback FALSE, so these lamps
// light only because the PLC drives them - solid while latched, flashing while
// latched during Clearing.
SS_EStop1.bEnable	:= GVL_EtherCAT_1_SIM.FG_System_Panel_EL2809_1.bOut13;
SS_EStop2.bEnable	:= GVL_EtherCAT_1_SIM.FG_System_Panel_EL2809_1.bOut14;

// --- Door DO 1..6 -> the six safety locks -----------------------------------
// The PLC commands these locked throughout Production and releases them in
// Maintenance and Manual, which is the only way into the cell.
B_SafetyDoor11.bLock	:= GVL_EtherCAT_1_SIM.FG_System_Door_EL2008_1.bOut1;
B_SafetyDoor12.bLock	:= GVL_EtherCAT_1_SIM.FG_System_Door_EL2008_1.bOut2;
B_SafetyDoor13.bLock	:= GVL_EtherCAT_1_SIM.FG_System_Door_EL2008_1.bOut3;
B_SafetyDoor21.bLock	:= GVL_EtherCAT_1_SIM.FG_System_Door_EL2008_1.bOut4;
B_SafetyDoor22.bLock	:= GVL_EtherCAT_1_SIM.FG_System_Door_EL2008_1.bOut5;
B_SafetyDoor23.bLock	:= GVL_EtherCAT_1_SIM.FG_System_Door_EL2008_1.bOut6;

// Spare after FG_System: Panel EL1809 DI 11-16; Door EL1809 DI 13-16;
// Panel EL2809 DO 15-16; Door EL2008 DO 7-8.]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>