<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="FB_Sercos_FSM" Id="{492a54f3-e4af-453f-b13b-69d90c4f6dd9}" SpecialFunc="None">
    <Declaration><![CDATA[// ============================================================================
// Sercos drive state machine - LOCAL COPY of OC_EtherCAT 1.1.8 FB_Sercos_FSM,
// with two fixes. Remove this file (and Library\FB_Sercos_VC) once OC_EtherCAT
// ships them.
//
// IT SHADOWS THE LIBRARY BLOCK BY NAME. A project POU wins over an unqualified
// library POU of the same name, so the OC Assistant generated declarations
// (Lift01_Y_Lift : FB_Sercos_VC) bind to the local copies without touching the
// generated region. FB_Sercos_VC is copied as well, because the compiled library
// FB_Sercos_VC would keep instantiating the library's own FB_Sercos_FSM.
//
// FIX 1 - CONTROL WORD BIT 13 MEANS RUN. The library treated b13 = 1 as halt.
// On an AX5000 (ESI Beckhoff AX5125-xxxx-0011 Dict.xml, S-0-0134 bit 13) the
// drive halts on 1 -> 0 and restarts on 0 -> 1, so an NC that enables the drive
// sends 1. The library therefore parked an enabled drive in S5b_Halt, reporting
// b3_CommandProcessing = 0 ("drive ignores the command values") and b4 = 1 -
// status word 16#C010 instead of 16#C008 - and the NC never declared the axis
// operational. Swapped in S4, S5a, S5b and S6.
//
// FIX 2 - S4_SwitchOn REPORTS "10", NOT "01". The library dropped b15 and raised
// b14 for one cycle between "10" (ready, torque-free) and "11" (in operation). A
// real drive never steps back like that, and an NC sampling that cycle reads a
// drive that lost its power stage.
//
// Unchanged from the library: the fault reset on a rising edge of bit 13 (a real
// drive resets through procedure command S-0-0099), and every type it uses -
// E_Sercos_State, ST_Sercos_ControlWord, ST_Sercos_StatusWord - still comes from
// OC_EtherCAT.
// ============================================================================
FUNCTION_BLOCK FB_Sercos_FSM
VAR_INPUT
	bPower						: BOOL := TRUE;
	stControl					: ST_Sercos_ControlWord;
END_VAR

VAR_OUTPUT
	stStatus					: ST_Sercos_StatusWord;
END_VAR

VAR
	_eState 					: E_Sercos_State := E_Sercos_State.S1_NotReadyToSwitchOn;
	_rTrig_Reset 				: R_TRIG;
	_bError						: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[_rTrig_Reset(CLK := stControl.b13_Halt);

CASE _eState OF
	E_Sercos_State.S1_NotReadyToSwitchOn 	: S1_NotReadyToSwitchOn();
	E_Sercos_State.S2_SwitchOnDisabled 		: S2_SwitchOnDisabled();
	E_Sercos_State.S3_ReadyToSwitchOn 		: S3_ReadyToSwitchOn();
	E_Sercos_State.S4_SwitchOn 				: S4_SwitchOn();
	E_Sercos_State.S5a_DriveInOperation 	: S5a_DriveInOperation();
	E_Sercos_State.S5b_Halt 				: S5b_Halt();
	E_Sercos_State.S6_QuickStop 			: S6_QuickStop();
	E_Sercos_State.S7_FaultReactionActive 	: S7_FaultReactionActive();
	E_Sercos_State.S8_Fault 				: S8_Fault();
END_CASE]]></ST>
    </Implementation>
    <Property Name="bError" Id="{39ffa9fb-9990-4f9a-9d51-66864e2fd1f3}">
      <Declaration><![CDATA[PROPERTY PUBLIC bError : BOOL]]></Declaration>
      <Set Name="Set" Id="{9e5ac37f-c71c-4143-b9b4-eed3b3d42810}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_bError := bError;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="eState" Id="{9a066e8c-c2a4-41a1-af7c-1c27572e3f50}">
      <Declaration><![CDATA[PROPERTY eState : E_Sercos_State]]></Declaration>
      <Get Name="Get" Id="{214c0099-519c-4f06-8ad1-3709e1990fd7}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[eState := _eState;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="nControl" Id="{92bc2cc2-1872-49ed-add3-473c55571115}">
      <Declaration><![CDATA[PROPERTY nControl : WORD]]></Declaration>
      <Get Name="Get" Id="{dfe772e4-1622-442d-8467-339ca58a3e68}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[nControl.0	:= stControl.b0_Reserved;
nControl.1	:= stControl.b1_Reserved;
nControl.2	:= stControl.b2_Reserved;
nControl.3	:= stControl.b3_Reserved;
nControl.4	:= stControl.b4_Reserved;
nControl.5	:= stControl.b5_Reserved;
nControl.6	:= stControl.b6_Reserved;
nControl.7	:= stControl.b7_Reserved;
nControl.8	:= stControl.b8_Reserved;
nControl.9	:= stControl.b9_Reserved;
nControl.10	:= stControl.b10_OperationMode;
nControl.11	:= stControl.b11_Reserved;
nControl.12	:= stControl.b12_Reserved;
nControl.13	:= stControl.b13_Halt;
nControl.14	:= stControl.b14_Start;
nControl.15 := stControl.b15_Enable;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{2aabf7db-4fd1-400d-898b-e305ab723593}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[stControl.b0_Reserved 			:= nControl.0;
stControl.b1_Reserved			:= nControl.1;
stControl.b2_Reserved			:= nControl.2;
stControl.b3_Reserved			:= nControl.3;
stControl.b4_Reserved			:= nControl.4;
stControl.b5_Reserved			:= nControl.5;
stControl.b6_Reserved			:= nControl.6;
stControl.b7_Reserved			:= nControl.7;
stControl.b8_Reserved			:= nControl.8;
stControl.b9_Reserved			:= nControl.9;
stControl.b10_OperationMode		:= nControl.10;
stControl.b11_Reserved			:= nControl.11;
stControl.b12_Reserved			:= nControl.12;
stControl.b13_Halt				:= nControl.13;
stControl.b14_Start				:= nControl.14;
stControl.b15_Enable			:= nControl.15;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="nStatus" Id="{73c34c30-89d0-4f9b-aa4d-23bcf34ceb67}">
      <Declaration><![CDATA[PROPERTY nStatus : WORD]]></Declaration>
      <Get Name="Get" Id="{412869d2-ba02-4d8f-9118-c66dabaaa80d}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[nStatus.0 	:= stStatus.b0_Reserved;
nStatus.1 	:= stStatus.b1_Reserved;
nStatus.2 	:= stStatus.b2_Reserved;
nStatus.3 	:= stStatus.b3_CommandProcessing;
nStatus.4 	:= stStatus.b4_Halt;
nStatus.5 	:= stStatus.b5_PositionFeedback;
nStatus.6 	:= stStatus.b6_Reserved;
nStatus.7 	:= stStatus.b7_QuickStop;
nStatus.8 	:= stStatus.b8_Reserved;
nStatus.9 	:= stStatus.b9_Reserved;
nStatus.10 	:= stStatus.b10_OperationMode;
nStatus.11 	:= stStatus.b11_Reserved;
nStatus.12 	:= stStatus.b12_Warning;
nStatus.13 	:= stStatus.b13_Error;
nStatus.14 	:= stStatus.b14_ReadyToOperate;
nStatus.15 	:= stStatus.b15_ReadyToOperate;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="S1_NotReadyToSwitchOn" Id="{1aaee824-5da2-454d-a8ca-7b89b73af4b9}">
      <Declaration><![CDATA[METHOD PRIVATE S1_NotReadyToSwitchOn : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stStatus.b15_ReadyToOperate 		:= FALSE;
stStatus.b14_ReadyToOperate 		:= FALSE;
stStatus.b13_Error 					:= FALSE;
stStatus.b7_QuickStop 				:= FALSE;
stStatus.b4_Halt 					:= FALSE;
stStatus.b3_CommandProcessing 		:= FALSE;

_eState := E_Sercos_State.S2_SwitchOnDisabled;]]></ST>
      </Implementation>
    </Method>
    <Method Name="S2_SwitchOnDisabled" Id="{3fb97c5b-3ce0-4cb2-bac8-875e6e5ea56b}">
      <Declaration><![CDATA[METHOD PRIVATE S2_SwitchOnDisabled : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stStatus.b15_ReadyToOperate 		:= FALSE;
stStatus.b14_ReadyToOperate 		:= TRUE;
stStatus.b13_Error 					:= FALSE;
stStatus.b7_QuickStop 				:= FALSE;
stStatus.b4_Halt 					:= FALSE;
stStatus.b3_CommandProcessing 		:= FALSE;

IF bPower THEN
	_eState := E_Sercos_State.S3_ReadyToSwitchOn;
	RETURN;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="S3_ReadyToSwitchOn" Id="{5e6caa87-2bb5-45d6-9922-e6fbf2df1dd4}">
      <Declaration><![CDATA[METHOD PRIVATE S3_ReadyToSwitchOn : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stStatus.b15_ReadyToOperate 		:= TRUE;
stStatus.b14_ReadyToOperate 		:= FALSE;
stStatus.b13_Error 					:= FALSE;
stStatus.b7_QuickStop 				:= FALSE;
stStatus.b4_Halt 					:= FALSE;
stStatus.b3_CommandProcessing 		:= FALSE;

IF NOT bPower THEN
	_eState := E_Sercos_State.S2_SwitchOnDisabled;
	RETURN;
END_IF

IF _bError THEN
	_eState := E_Sercos_State.S7_FaultReactionActive;
	RETURN;
END_IF

IF stControl.b15_Enable THEN
	_eState := E_Sercos_State.S4_SwitchOn;
	RETURN;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="S4_SwitchOn" Id="{3002651c-f4f9-4e2b-b3ec-a2fcbbe14fb3}">
      <Declaration><![CDATA[METHOD PRIVATE S4_SwitchOn : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// FIX 2: "10" (ready, torque-free) until in operation - the library reported "01".
stStatus.b15_ReadyToOperate 		:= TRUE;
stStatus.b14_ReadyToOperate 		:= FALSE;
stStatus.b13_Error 					:= FALSE;
stStatus.b7_QuickStop 				:= FALSE;
stStatus.b4_Halt 					:= FALSE;
stStatus.b3_CommandProcessing 		:= FALSE;

IF NOT bPower THEN
	_eState := E_Sercos_State.S2_SwitchOnDisabled;
	RETURN;
END_IF

IF _bError THEN
	_eState := E_Sercos_State.S7_FaultReactionActive;
	RETURN;
END_IF

IF NOT stControl.b15_Enable THEN
	_eState := E_Sercos_State.S3_ReadyToSwitchOn;
	RETURN;
END_IF

// FIX 1 - AX5000: S-0-0134 bit 13 = 1 means run, 0 means halt.
IF stControl.b13_Halt AND stControl.b14_Start THEN
	_eState := E_Sercos_State.S5a_DriveInOperation;
	RETURN;
END_IF

IF NOT stControl.b13_Halt AND stControl.b14_Start THEN
	_eState := E_Sercos_State.S5b_Halt;
	RETURN;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="S5a_DriveInOperation" Id="{e5bb1e51-1815-4ea2-ba2b-393cf39f5155}">
      <Declaration><![CDATA[METHOD PRIVATE S5a_DriveInOperation : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stStatus.b15_ReadyToOperate 		:= TRUE;
stStatus.b14_ReadyToOperate 		:= TRUE;
stStatus.b13_Error 					:= FALSE;
stStatus.b7_QuickStop 				:= FALSE;
stStatus.b4_Halt 					:= FALSE;
stStatus.b3_CommandProcessing 		:= TRUE;

IF NOT bPower THEN
	_eState := E_Sercos_State.S2_SwitchOnDisabled;
	RETURN;
END_IF

IF _bError THEN
	_eState := E_Sercos_State.S7_FaultReactionActive;
	RETURN;
END_IF

IF NOT stControl.b15_Enable THEN
	_eState := E_Sercos_State.S3_ReadyToSwitchOn;
	RETURN;
END_IF

IF NOT stControl.b14_Start THEN
	_eState := E_Sercos_State.S6_QuickStop;
	RETURN;
END_IF

// FIX 1 - AX5000: S-0-0134 bit 13 = 1 means run, 0 means halt.
IF NOT stControl.b13_Halt THEN
	_eState := E_Sercos_State.S5b_Halt;
	RETURN;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="S5b_Halt" Id="{89a4bb81-f98f-4042-ae69-5b510d7bbe22}">
      <Declaration><![CDATA[METHOD PRIVATE S5b_Halt : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stStatus.b15_ReadyToOperate 		:= TRUE;
stStatus.b14_ReadyToOperate 		:= TRUE;
stStatus.b13_Error 					:= FALSE;
stStatus.b7_QuickStop 				:= FALSE;
stStatus.b4_Halt 					:= TRUE;
stStatus.b3_CommandProcessing 		:= FALSE;

IF NOT bPower THEN
	_eState := E_Sercos_State.S2_SwitchOnDisabled;
	RETURN;
END_IF

IF _bError THEN
	_eState := E_Sercos_State.S7_FaultReactionActive;
	RETURN;
END_IF

IF NOT stControl.b15_Enable THEN
	_eState := E_Sercos_State.S3_ReadyToSwitchOn;
	RETURN;
END_IF

IF NOT stControl.b14_Start THEN
	_eState := E_Sercos_State.S6_QuickStop;
	RETURN;
END_IF

// FIX 1 - AX5000: S-0-0134 bit 13 = 1 means run, 0 means halt.
IF stControl.b13_Halt THEN
	_eState := E_Sercos_State.S5a_DriveInOperation;
	RETURN;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="S6_QuickStop" Id="{45a2788e-48ec-429e-8b2e-701f393c61e9}">
      <Declaration><![CDATA[METHOD PRIVATE S6_QuickStop : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stStatus.b15_ReadyToOperate 		:= TRUE;
stStatus.b14_ReadyToOperate 		:= TRUE;
stStatus.b13_Error 					:= FALSE;
stStatus.b7_QuickStop 				:= TRUE;
stStatus.b4_Halt 					:= TRUE;
stStatus.b3_CommandProcessing 		:= FALSE;

IF NOT bPower THEN
	_eState := E_Sercos_State.S2_SwitchOnDisabled;
	RETURN;
END_IF

IF _bError THEN
	_eState := E_Sercos_State.S7_FaultReactionActive;
	RETURN;
END_IF

IF NOT stControl.b15_Enable THEN
	_eState := E_Sercos_State.S3_ReadyToSwitchOn;
	RETURN;
END_IF

// FIX 1 - AX5000: S-0-0134 bit 13 = 1 means run, 0 means halt.
IF stControl.b13_Halt AND stControl.b14_Start THEN
	_eState := E_Sercos_State.S5a_DriveInOperation;
	RETURN;
END_IF

IF NOT stControl.b13_Halt AND stControl.b14_Start THEN
	_eState := E_Sercos_State.S5b_Halt;
	RETURN;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="S7_FaultReactionActive" Id="{2c8eb2b7-2ebf-4c8f-9419-dee460062df8}">
      <Declaration><![CDATA[METHOD PRIVATE S7_FaultReactionActive : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stStatus.b15_ReadyToOperate 		:= TRUE;
stStatus.b14_ReadyToOperate 		:= TRUE;
stStatus.b13_Error 					:= TRUE;
stStatus.b7_QuickStop 				:= FALSE;
stStatus.b4_Halt 					:= FALSE;
stStatus.b3_CommandProcessing 		:= FALSE;

IF NOT bPower THEN
	_eState := E_Sercos_State.S2_SwitchOnDisabled;
	RETURN;
END_IF

_eState := E_Sercos_State.S8_Fault;]]></ST>
      </Implementation>
    </Method>
    <Method Name="S8_Fault" Id="{5854fc90-8c21-4e78-8f2c-79988d1db541}">
      <Declaration><![CDATA[METHOD PRIVATE S8_Fault : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stStatus.b15_ReadyToOperate 		:= TRUE;
stStatus.b14_ReadyToOperate 		:= FALSE;
stStatus.b13_Error 					:= TRUE;
stStatus.b7_QuickStop 				:= FALSE;
stStatus.b4_Halt 					:= FALSE;
stStatus.b3_CommandProcessing 		:= FALSE;

// Unchanged from the library: reset on a rising edge of control bit 13.
IF _rTrig_Reset.Q THEN
	_eState := E_Sercos_State.S2_SwitchOnDisabled;
	_bError := FALSE;
	RETURN;
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
